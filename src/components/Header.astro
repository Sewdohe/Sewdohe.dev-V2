---
import { Icon } from 'astro-icon/components';
import HeaderLink from './HeaderLink.astro';
import { Image } from 'astro:assets';
import avatar from '../assets/avatars/32x32.png';
---

<header class="z-30">
	<nav>
		<a href="/"><Image src={avatar} alt="Sewdohe's avatar" /></a>
		<div class="internal-links flex flex-row">
			<HeaderLink href="/" icon="fa-solid:home">Home</HeaderLink>
			<HeaderLink href="/blog" icon="fa-solid:newspaper">Blog</HeaderLink>
			<HeaderLink href="/projects" icon="fa-solid:code">Projects</HeaderLink>
			<HeaderLink href="/about" icon="fa-solid:user">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/sewdohe" target="_blank">
				<span class="sr-only">View my Github</span>
				<Icon color="#0FBF3E" name="fa6-brands:github" size=32></Icon>
			</a>
			<a href="https://bsky.app/profile/divnectar.com" target="_blank">
				<span class="sr-only">View my Github</span>
				<Icon color={"#0F73FF"} name="fa6-brands:bluesky" size="32"></Icon>
			</a>
		</div>
	</nav>
</header>
<div class="nav-spacer" />
<style>
	header {
		margin: 0;
		padding: 0 1em;
		color: white;
		background: rgba(255, 255, 255, 0.05);
		position: fixed;
		width: 100vw;
		/* border-radius: 16px; */
		border-bottom: 1px solid var(--sakura-pink);
		box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
		backdrop-filter: blur(12.5px);
		/* -webkit-backdrop-filter: blur(7.9px); */
	}
	header::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
	z-index: -1;
    
    /* Embeds an SVG noise texture directly in CSS */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    
    /* Blends the noise with your background glass */
    opacity: 0.15; 
    mix-blend-mode: overlay;
    pointer-events: none; /* Allows clicking through the noise overlay */
}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		/* From https://css.glass */
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--brand-primary);
	}
	.nav-spacer {
		height: 4rem;
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
