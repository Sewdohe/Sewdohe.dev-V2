---
const today = new Date();
import { Icon } from 'astro-icon/components'
---

<footer>
	&copy; {today.getFullYear()} Sewdohe. Made with ❤️ by hand.
	<div class="social-links">
		<a href="https://github.com/sewdohe" target="_blank">
			<span class="sr-only">Follow me on Github</span>
			<Icon name="fa-brands:github" size=32 />
		</a>
	</div>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		color: white;
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: white;
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
