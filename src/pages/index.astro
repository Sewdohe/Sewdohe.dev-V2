---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Sewdohe.dev</h1>
			<p>
				Welcome to my little slice of the internet! Glad you stopped by! Not alot to see here as of now - I'm working
				on this new website!!
			</p>
			<p>
				I was previously using an Astro template website that allowed me to author posts using Obsidian - but template code was quite
				complicated, and I'd like to just **build** my website from scratch again. There's quite nothing like a hand-built site ❤️
			</p>
		</main>
		<Footer />
	</body>
</html>
