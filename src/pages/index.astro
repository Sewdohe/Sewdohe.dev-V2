---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import FormattedDate from "../components/FormattedDate.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import DailyVisitors from "../components/DailyVisitors";
import Prose from "../components/Prose.astro";
import ImageWithLink from "../components/ImageWithLink.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const blog = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---


<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <h1 class="font-handwritten">Sewdohe.dev</h1>
  <DailyVisitors client:load />
  <Prose>
    <p>
      Welcome to my little slice of the internet! Glad you stopped by! Not
      alot to see here as of now - I'm working on this new website!!
    </p>
    <p>
      I was previously using an Astro template website that allowed me to
      author posts using Obsidian - but template code was quite complicated,
      and I'd like to just <b>build</b> my website from scratch again. Easier for
      me to add features and customize! There's quite nothing like a hand-built
      site ❤️ They are getting more and more rare these days!
    </p>
  </Prose>
  <hr />
  <section class="flex flex-col md:flex-row gap-6">
    <div>
      <h1>Latest Projects</h1>
      <ul>
        {
          projects.map((project) => (
            <ImageWithLink type="projects" {...project} />
          ))
        }
      </ul>
    </div>
    <div>
      <h1>Latest Blog Posts</h1>
      <ul>
        {
          blog.map((blog) => (
            <ImageWithLink type="blog" {...blog} />
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
